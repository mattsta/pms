# Backlog-triage scenario customization

# Runtime data paths (optional; defaults to generated .tmp directory)
# export PMS_DATA_DIR="$PWD/.workflow-backlog-triage"
# export PMS_DATABASE_PATH="$PMS_DATA_DIR/pms.db"
# export PMS_LOG_DIR="$PMS_DATA_DIR/logs"

# Naming + identity
export PMS_BACKLOG_SUFFIX="triage-a"
export PMS_BACKLOG_ORG="Acme Org"
export PMS_BACKLOG_PORTFOLIO="Platform Portfolio"
export PMS_BACKLOG_PROGRAM="Roadmap Program"
export PMS_BACKLOG_PRODUCT="Payments Platform"
export PMS_BACKLOG_PROJECT="Payments Backlog Triage"
export PMS_BACKLOG_ACTOR="triage-lead"

# Backlog flow details
export PMS_BACKLOG_QUEUE_NAME="backlog-triage-queue"
export PMS_BACKLOG_CRITICAL_TASK="Triage top customer issue"
export PMS_BACKLOG_HIGH_TASK="Refine API pagination backlog"
export PMS_BACKLOG_DUPLICATE_TASK="Consolidate queue filter naming"
export PMS_BACKLOG_LOW_TASK="Remove stale label alias"

# Run:
# ./scripts/run_backlog_triage_flow.sh
# ./scripts/run_backlog_triage_contract_smoke.sh

# Operational-review scenario customization

# Runtime data paths (optional; defaults to generated .tmp directory)
# export PMS_DATA_DIR="$PWD/.workflow-operational-review"
# export PMS_DATABASE_PATH="$PMS_DATA_DIR/pms.db"
# export PMS_LOG_DIR="$PMS_DATA_DIR/logs"

# Naming + identity
export PMS_OPERATIONS_SUFFIX="weekly-a"
export PMS_OPERATIONS_ORG="Acme Org"
export PMS_OPERATIONS_PORTFOLIO="Operational Review Portfolio"
export PMS_OPERATIONS_PROGRAM="Reliability Program"
export PMS_OPERATIONS_PRODUCT="Payments Platform"
export PMS_OPERATIONS_PROJECT="Weekly Reliability Review"
export PMS_OPERATIONS_ACTOR="ops-reviewer"

# Review flow details
export PMS_OPERATIONS_QUEUE_NAME="ops-review-queue"
export PMS_OPERATIONS_REVIEW_NOTE="Weekly operational review checkpoint"
export PMS_OPERATIONS_REVIEW_METADATA='{"session":"operational-review","cadence":"weekly"}'
export PMS_OPERATIONS_REVIEW_TASK="Review blocker queue"
export PMS_OPERATIONS_STATUS_TASK="Refresh status notes"
export PMS_OPERATIONS_BLOCKED_TASK="Resolve escalated dependency"
export PMS_OPERATIONS_NEXT_TASK="Prepare next operator actions"

# Run:
# ./scripts/run_operational_review_flow.sh
# ./scripts/run_operational_review_contract_smoke.sh

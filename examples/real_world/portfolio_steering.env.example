# Portfolio-steering scenario customization

# Runtime data paths (optional; defaults to generated .tmp directory)
# export PMS_DATA_DIR="$PWD/.workflow-portfolio-steering"
# export PMS_DATABASE_PATH="$PMS_DATA_DIR/pms.db"
# export PMS_LOG_DIR="$PMS_DATA_DIR/logs"

# Scope + identity
export PMS_STEERING_SUFFIX="launch-a"
export PMS_STEERING_ORG="OmniCorp"
export PMS_STEERING_PORTFOLIO="Customer Experience"
export PMS_STEERING_PROGRAM="Q3 Launch"
export PMS_STEERING_API_PRODUCT="Checkout API"
export PMS_STEERING_UI_PRODUCT="Web Store"
export PMS_STEERING_API_PROJECT="Checkout API v2"
export PMS_STEERING_UI_PROJECT="Web Store v5"
export PMS_STEERING_ACTOR="steering-bot"

# Delivery details
export PMS_STEERING_API_GOAL="Ship Checkout API v2"
export PMS_STEERING_UI_GOAL="Ship Web Store v5"
export PMS_STEERING_API_TASK="Implement payment endpoint"
export PMS_STEERING_UI_TASK="Checkout UI integration"

# Run:
# ./scripts/run_portfolio_steering_flow.sh
# ./scripts/run_portfolio_steering_contract_smoke.sh

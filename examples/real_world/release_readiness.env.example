# Release-readiness / launch-control scenario customization

# Runtime data paths (optional; defaults to generated .tmp directory)
# export PMS_DATA_DIR="$PWD/.workflow-release"
# export PMS_DATABASE_PATH="$PMS_DATA_DIR/pms.db"
# export PMS_LOG_DIR="$PMS_DATA_DIR/logs"

# Naming + identity
export PMS_RELEASE_SUFFIX="launch-a"
export PMS_RELEASE_ORG="Acme Org"
export PMS_RELEASE_PORTFOLIO="Launch Portfolio"
export PMS_RELEASE_PROGRAM="Launch Program"
export PMS_RELEASE_PRODUCT="Payments Platform"
export PMS_RELEASE_PROJECT="Gateway Launch Control"
export PMS_RELEASE_ACTOR="release-manager"
export PMS_RELEASE_TEST_SERVER="local-smoke"

# Release flow details
export PMS_RELEASE_NOTES_TASK="Finalize release notes"
export PMS_RELEASE_SMOKE_TASK="Run final smoke validation"
export PMS_RELEASE_APPROVAL_TASK="Approve go/no-go decision"
export PMS_RELEASE_GOAL="Launch Gateway Launch Control"
export PMS_RELEASE_OBJECTIVE="Clear release gate for Gateway Launch Control"
export PMS_RELEASE_STATUS_FIELD="release_status"
export PMS_RELEASE_QUEUE_NAME="release-ready-queue"
export PMS_RELEASE_RULE_NAME="release-ready-comment"

# Run:
# ./scripts/run_release_readiness_flow.sh
# ./scripts/run_release_readiness_contract_smoke.sh
